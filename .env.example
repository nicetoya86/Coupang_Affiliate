# Coupang Affiliate Ecosystem Configuration

# ============================================================================
# Google Sheets Integration
# ============================================================================

# Sheet ID (from URL: https://docs.google.com/spreadsheets/d/{ID}/...)
GOOGLE_SHEET_ID=1K_howGdnGcBgiHlCXTpvU0LnYAsGvsUe0Iwkjc3t-JA

# Sheet name (default: 시트1)
GOOGLE_SHEET_NAME=시트1

# Path to Google Service Account JSON key file (for API access)
# Download from: Google Cloud Console → Service Accounts → Keys → Create new JSON key
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./scripts/service-account.json

# ============================================================================
# Cloudinary Image Hosting
# ============================================================================

# Cloudinary Cloud Name (from: Dashboard → Settings → API Keys)
CLOUDINARY_CLOUD_NAME=your-cloud-name

# Cloudinary Upload Preset (unsigned, for public content)
# Create at: Dashboard → Settings → Upload
CLOUDINARY_UPLOAD_PRESET=your-preset-name

# ============================================================================
# n8n Workflow (managed in n8n UI, not needed here)
# ============================================================================
# The following are configured in n8n workflow, not via environment:
#   - NVIDIA_API_KEY (Threads integration)
#   - THREADS_USER_ID (Threads integration)
#   - THREADS_ACCESS_TOKEN (Threads integration)
#   - Telegram credentials (if error alerts enabled)

# 이 파일을 복사해서 .env로 저장한 뒤, 실제 값으로 채워주세요.
# .env는 절대 커밋/공유/채팅에 붙여넣지 마세요 (.gitignore에 이미 등록됨).

# 구글 서비스계정 JSON 키 파일 경로 (Sheets API 사용)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# 상품 큐로 쓸 구글시트 ID와 탭 이름
# 시트 URL .../d/{여기}/edit 에서 확인
GOOGLE_SHEET_ID=여기에_시트ID_입력
GOOGLE_SHEET_NAME=Sheet1

# 이 할인율(%) 이상인 상품만 수집 (기본값 90)
MIN_DISCOUNT_RATE=90

# (더 이상 미사용 - 서비스계정은 개인 구글 드라이브에 저장공간이 없어 업로드가 막혀있음.
# 합성 이미지는 아래 IMGBB_API_KEY로 대체함. 과거 add-product.js 단건 흐름의 흔적으로 남겨둠)
GOOGLE_DRIVE_FOLDER_ID=

# 합성 이미지(할인율 배지) 업로드용 imgbb API 키 - https://api.imgbb.com/ 에서 무료 발급
IMGBB_API_KEY=여기에_imgbb_API_키_입력
